{
  "manifest_version": 3,
  "name": "微博评论点赞助手",
  "version": "1.0",
  "description": "自动为微博评论点赞",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.weibo.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.weibo.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
} 